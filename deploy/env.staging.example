# Plantilla del .env de staging (spec 009). Se copia UNA vez a
# /srv/sunat/staging/api/shared/.env y se completa en el servidor.
# Los valores <entre ángulos> van SOLO en el servidor y en el gestor de
# contraseñas: nunca en el repositorio (es público, A-46).
APP_NAME="Facturación SUNAT"
APP_ENV=staging
APP_KEY="<php artisan key:generate --show; guardar también en el gestor de contraseñas>"
APP_DEBUG=false
APP_URL=https://staging-api.<dominio>
FRONTEND_URL=https://staging-app.<dominio>
CORS_ALLOWED_ORIGINS=https://staging-app.<dominio>,https://localhost
# Versión mínima de la app Android (spec 013, A-67); vacía = sin control.
APP_ANDROID_MIN_VERSION=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sunat_staging
DB_USERNAME=sunat_staging
DB_PASSWORD="<la genera provision.sh>"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Correo transaccional con el dominio autenticado (A-47).
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST="<host SMTP del proveedor>"
MAIL_PORT=587
MAIL_USERNAME="<usuario SMTP>"
MAIL_PASSWORD="<contraseña SMTP>"
MAIL_FROM_ADDRESS="no-reply@<dominio>"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_EXPIRATION=1440
SANCTUM_TOKEN_PREFIX=sunat_staging_

# SUNAT: sigue siendo beta hasta la spec 008.
SUNAT_BETA_USER="{ruc}MODDATOS"
SUNAT_BETA_PASSWORD=moddatos
SUNAT_TIMEOUT=10
SUNAT_SEND_TIMEOUT=15
SUNAT_RATE_LIMIT_PAUSE=5

# Copias de seguridad en almacenamiento compatible con S3 (A-45).
AWS_ACCESS_KEY_ID="<clave de acceso con permiso solo sobre el bucket>"
AWS_SECRET_ACCESS_KEY="<clave secreta>"
AWS_DEFAULT_REGION="<región>"
AWS_BUCKET="<bucket>"
AWS_ENDPOINT="<endpoint S3 del proveedor; vacío para AWS>"
AWS_USE_PATH_STYLE_ENDPOINT=false
BACKUP_ARCHIVE_PASSWORD="<openssl rand -base64 32; guardar también en el gestor de contraseñas>"

# Avisos (A-48).
OPS_ALERT_EMAIL="<correo del responsable del SaaS>"
OPS_HEARTBEAT_URL="<URL de ping del monitor de latidos: scheduler>"
OPS_BACKUP_PING_URL="<URL de ping del monitor de latidos: copia diaria>"
