# API de {{ENV}} (spec 009). La genera provision.sh; no editar en el servidor.
server {
    listen 80;
    listen [::]:80;
    server_name {{HOST}};

    root /srv/sunat/{{ENV}}/api/current/public;
    index index.php;
    charset utf-8;

    # Certificado y logo: hasta 1 MB cada uno (con margen para el multipart).
    client_max_body_size 2m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/sunat.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        # $realpath_root: resuelve el enlace «current» para que OPcache vea la versión nueva.
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}
