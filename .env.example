# Desarrollo local. Para staging y producción: deploy/env.<ambiente>.example.
# Nunca pongas APP_ENV=local en un servidor accesible desde fuera: el seeder
# crearía cuentas de prueba con una contraseña pública (README).
APP_NAME="Facturación SUNAT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos por CORS, separados por comas (por defecto, FRONTEND_URL). Nunca «*».
# La app Android (spec 013) llama desde https://localhost: agregarlo junto al frontend.
CORS_ALLOWED_ORIGINS=
# Versión mínima de la app Android (x.y.z); vacía = sin control (spec 013).
APP_ANDROID_MIN_VERSION=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_api_sunat
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Fotos de producto y logos (spec 016): `public` en desarrollo local, `images` con S3.
IMAGES_DISK=public

# S3 (A-79): un bucket con dos carpetas. Fotos y logos en AWS_ROOT (lectura pública);
# copias de seguridad en AWS_BACKUP_ROOT (privadas, BACKUP_DISK=s3).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ROOT=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_BACKUP_ROOT=
# Clave propia de las copias (opcional; por defecto, la de arriba).
AWS_BACKUP_ACCESS_KEY_ID=
AWS_BACKUP_SECRET_ACCESS_KEY=
QUEUE_CONNECTION=database

CACHE_STORE=database

# En desarrollo el correo va al log (enlaces de invitación y recuperación).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Tokens de Sanctum (Bearer).
SANCTUM_EXPIRATION=1440
SANCTUM_TOKEN_PREFIX=sunat_beta_

# SUNAT beta (spec 004 y 005). Credenciales genéricas públicas de prueba (A-31).
SUNAT_BETA_USER="{ruc}MODDATOS"
SUNAT_BETA_PASSWORD=moddatos
SUNAT_TIMEOUT=10
SUNAT_SEND_TIMEOUT=15
SUNAT_RATE_LIMIT_PAUSE=5
# Solo para simular una caída en pruebas manuales:
# SUNAT_BETA_ENDPOINT=https://127.0.0.1:9/billService
